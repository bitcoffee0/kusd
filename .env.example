# This branch deliberately accepts Kaspa Testnet 10 only.
KASPA_NETWORK=testnet-10

# `public` selects the public TN10 resolver used by the network scripts.
# An explicit TN10 wRPC endpoint can be supplied instead.
KASPA_RPC_URL=public

# Hex-encoded private key for a disposable TN10-only wallet. Never commit it.
KASPA_PRIVATE_KEY=

# Optional prefix for ignored deployment manifests and progress files.
KUSD_TAG=kusd

# Optional DAA buffers for a complete deployment over a public RPC.
KUSD_DEPLOYMENT_DAA_BUFFER=10000
KUSD_MIN_DEPLOYMENT_DAA_RUNWAY=4000
KUSD_PROPOSAL_DAA_BUFFER=3000
