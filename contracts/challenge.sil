pragma silverscript ^0.1.0;

contract Challenge(
    pubkey initOwner, pubkey initChallenger, byte[32] initPositionId, byte[32] initAssetId,
    int initDebt, int initAssignedReserve, byte[32] initReserveId,
    int initLiquidationPrice, int initRewardPpm, int initChallengePeriodDaa,
    int initAuctionDurationDaa,
    int initCollateralSompi, int initKccPrefixLen, int initKccSuffixLen,
    byte[32] initKccTemplateHash, byte[] auctionTemplatePrefix,
    byte[] auctionTemplateSuffix, byte[32] auctionTemplateHash
) {
    pubkey owner = initOwner; pubkey challenger = initChallenger; byte[32] positionId = initPositionId;
    byte[32] assetId = initAssetId; int debt = initDebt;
    int assignedReserve = initAssignedReserve; byte[32] reserveId = initReserveId;
    int liquidationPrice = initLiquidationPrice; int rewardPpm = initRewardPpm;
    int challengePeriodDaa = initChallengePeriodDaa;
    int auctionDurationDaa = initAuctionDurationDaa; int collateralSompi = initCollateralSompi;
    int kccPrefixLen = initKccPrefixLen; int kccSuffixLen = initKccSuffixLen;
    byte[32] kccTemplateHash = initKccTemplateHash;
    int constant MAX_INT = 9223372036854775807;

    struct TokenState { byte[32] ownerIdentifier; byte identifierType; int amount; bool isMinter; }

    function mulDivFloor(int x, int y, int d) : int {
        require(x >= 0 && y >= 0 && d > 0 && d <= 100000000);
        if (x / d > 0) { require(y <= MAX_INT / (x / d)); }
        int result = (x / d) * y;
        if (x % d > 0) { require(y / d <= (MAX_INT - result) / (x % d)); }
        result = result + (x % d) * (y / d);
        require((x % d) * (y % d) / d <= MAX_INT - result);
        result = result + (x % d) * (y % d) / d;
        return(result);
    }
    struct AuctionState {
        pubkey positionOwner; pubkey challenger; byte[32] positionId; byte[32] assetId; int debt;
        int assignedReserve; byte[32] reserveId; int liquidationPrice;
        int rewardPpm; int auctionDurationDaa; int collateralSompi;
        int kccPrefixLen; int kccSuffixLen; byte[32] kccTemplateHash;
    }
    byte constant IDENTIFIER_PUBKEY = 0x00;

    #[covenant.singleton(mode = verification, termination = allowed, name = avert)]
    function avertPolicy(State prevState, State[] nextStates, pubkey buyer,
        byte depositOutputIndex, TokenState challengerPayment) {
        require(nextStates.length == 0 && OpCovInputCount(prevState.positionId) == 1);
        int outIdx = unsigned(depositOutputIndex);
        require(outIdx < tx.outputs.length);
        require(tx.outputs[outIdx].scriptPubKey == byte[](new ScriptPubKeyP2PK(buyer)));
        require(tx.outputs[outIdx].value == tx.inputs[this.activeInputIndex].value);
        int price = mulDivFloor(prevState.collateralSompi,
            prevState.liquidationPrice, 100000000);
        require(OpCovInputCount(prevState.assetId) == 1 && OpCovOutputCount(prevState.assetId) == 1);
        int paymentIdx = OpCovInputIdx(prevState.assetId, 0);
        TokenState payment = readInputStateWithTemplate(paymentIdx,
            prevState.kccPrefixLen, prevState.kccSuffixLen, prevState.kccTemplateHash);
        require(payment.ownerIdentifier == byte[32](buyer)); require(payment.identifierType == IDENTIFIER_PUBKEY);
        require(payment.amount == price && !payment.isMinter);
        require(challengerPayment.ownerIdentifier == byte[32](prevState.challenger));
        require(challengerPayment.identifierType == IDENTIFIER_PUBKEY);
        require(challengerPayment.amount == price && !challengerPayment.isMinter);
        validateOutputStateWithInputTemplate(OpCovOutputIdx(prevState.assetId, 0),
            challengerPayment, paymentIdx, prevState.kccPrefixLen,
            prevState.kccSuffixLen, prevState.kccTemplateHash);
    }

    entry activatePolicy(byte auctionOutputIndex, AuctionState auctionState) {
        byte[32] challengeId = OpInputCovenantId(this.activeInputIndex);
        require(OpCovInputCount(challengeId) == 1 && OpCovOutputCount(challengeId) == 1);
        require(this.ageDaa >= challengePeriodDaa);
        require(auctionState.positionOwner == owner && auctionState.challenger == challenger);
        require(auctionState.positionId == positionId && auctionState.assetId == assetId);
        require(auctionState.debt == debt && auctionState.assignedReserve == assignedReserve);
        require(auctionState.reserveId == reserveId && auctionState.rewardPpm == rewardPpm);
        require(auctionState.liquidationPrice == liquidationPrice);
        require(auctionState.auctionDurationDaa == auctionDurationDaa);
        require(auctionState.collateralSompi == collateralSompi);
        require(auctionState.kccPrefixLen == kccPrefixLen && auctionState.kccSuffixLen == kccSuffixLen);
        require(auctionState.kccTemplateHash == kccTemplateHash);
        int outIdx = unsigned(auctionOutputIndex);
        require(outIdx < tx.outputs.length && outIdx == OpCovOutputIdx(challengeId, 0));
        require(tx.outputs[outIdx].value == tx.inputs[this.activeInputIndex].value);
        validateOutputStateWithTemplate(outIdx, auctionState, auctionTemplatePrefix,
            auctionTemplateSuffix, auctionTemplateHash);
        require(OpOutputCovenantId(outIdx) == challengeId);
    }
}
